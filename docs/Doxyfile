# Doxyfile enabling both HTML and LaTeX/PDF
PROJECT_NAME           = "T-27 Balanced-Ternary Toolkit"
PROJECT_NUMBER         = "0.2.0 review candidate"
OUTPUT_DIRECTORY       = build/doxygen

# HTML
GENERATE_HTML          = YES
HTML_OUTPUT            = html

# LaTeX/PDF
GENERATE_LATEX         = NO
LATEX_OUTPUT           = latex
USE_PDFLATEX           = YES
LATEX_BATCHMODE        = YES
LATEX_HIDE_INDICES     = NO
PDF_HYPERLINKS         = YES
EXTRA_PACKAGES         = amsmath, amssymb, mathtools

INPUT = include src/t27-core experimental/cpu/include experimental/cpu/src docs/design/isa-v0.md docs/guide/assembler.md docs/api-main.md docs/design/numeric-contract.md docs/design/alg-long-div.md docs/design/proof_long_div.md docs/guide/examples.md docs/guide/glossary.md docs/t27_groups.dox
USE_MDFILE_AS_MAINPAGE = docs/api-main.md
RECURSIVE              = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_METHODS  = YES

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

HAVE_DOT               = NO
DOT_NUM_THREADS        = 2
CLASS_GRAPH            = YES


WARN_IF_UNDOCUMENTED   = NO
WARNINGS               = YES
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO

WARN_AS_ERROR = YES
